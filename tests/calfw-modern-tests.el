;;; calfw-modern-tests.el --- Renderer regression tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'calfw-modern)

(defconst cfw-modern-test-date '(10 16 2026))

(defun cfw-modern-test-source (&optional count)
  (make-cfw:source
   :name "caldav.feishu.cn / 测试日历" :color "#579fff"
   :data (lambda (_begin _end)
           (append
            (cl-loop for index below (or count 5)
                     collect (make-cfw:event :title (format "中文长标题会议 %d 与工作进度回顾" index)
                                             :start-date cfw-modern-test-date
                                             :start-time (list (+ 9 (% index 5)) 0)
                                             :end-time (list (+ 10 (% index 5)) 0)))
            (list (list cfw-modern-test-date
                        (propertize "TODO 中文工作任务" 'todo-state "TODO" 'org-marker (point-marker))))))))

(defun cfw-modern-test-render (view width height &optional count)
  (let ((cfw:display-style 'modern) (cfw:display-calendar-holidays nil))
    (cfw:get-calendar-text width height :date cfw-modern-test-date :view view
                           :contents-sources (list (cfw-modern-test-source count)))))

(ert-deftest cfw-modern-four-views-fit-normal-viewport ()
  (dolist (view '(day week two-weeks month))
    (dolist (size '((116 62) (90 42) (150 75)))
      (let ((text (cfw-modern-test-render view (car size) (cadr size) 20)))
        (should (<= (length (split-string text "\n")) (cadr size)))
        (dolist (line (split-string text "\n")) (should (< (string-width line) (car size))))))))

(ert-deftest cfw-modern-sources-stay-at-top-and-wrap ()
  (let* ((sources (cl-loop for index below 8
                          collect (make-cfw:source :name (format "账户 / 较长来源名称%d" index) :color "blue")))
         (legend (cfw:modern--legend sources 30)))
    (should (> (length legend) 1))
    (dolist (line legend) (should (<= (string-width line) 30)))
    (dolist (source sources)
      (should (cl-some (lambda (line) (text-property-any 0 (length line) 'cfw:source source line)) legend))))
  (let ((text (cfw-modern-test-render 'two-weeks 116 62)))
    (should (string-match "测试日历" (mapconcat #'identity (cl-subseq (split-string text "\n") 0 4) "\n")))))

(ert-deftest cfw-modern-dense-day-shows-exact-hidden-count ()
  (let* ((date cfw-modern-test-date)
         (model `((contents . ((,date ,@(cl-loop for n below 20 collect (format "Task %02d" n)))))
                  (sorter . string-lessp)))
         (card (cfw:modern--card model date 40 6))
         (shown (length (cl-remove-if-not (lambda (line) (get-text-property 0 'cfw:row-count line)) (cdr card)))))
    (should (= 6 (length card)))
    (should (string-match-p (format "还有 %d 项" (- 20 shown)) (mapconcat #'identity card "\n")))
    (should (text-property-not-all 0 (length (nth shown (cdr card))) 'keymap nil (nth shown (cdr card))))))

(ert-deftest cfw-modern-keeps-org-marker-and-binds-overflow ()
  (with-temp-buffer
    (let* ((marker (point-marker))
           (item (propertize "TODO 任务" 'org-marker marker 'todo-state "TODO"))
           (entry (cfw:modern--entry item cfw-modern-test-date))
           (line (cfw:modern--entry-line entry (cfw:modern--label entry) 30 cfw-modern-test-date))
           (more (cfw:modern--more 10 30 cfw-modern-test-date)))
      (should (eq marker (get-text-property 0 'org-marker line)))
      (should (equal cfw-modern-test-date (get-text-property 0 'cfw:date line)))
      (should (eq #'cfw:modern--more-click (lookup-key (get-text-property 0 'keymap more) [mouse-1]))))))

(ert-deftest cfw-modern-overlapping-events-get-distinct-lanes ()
  (let* ((entries (list (list :start 540 :end 600 :text "A")
                        (list :start 570 :end 660 :text "B")
                        (list :start 660 :end 720 :text "C")))
         (placed (cfw:modern--lanes entries 480 4))
         (a (cl-find "A" placed :key (lambda (entry) (plist-get entry :text)) :test #'equal))
         (b (cl-find "B" placed :key (lambda (entry) (plist-get entry :text)) :test #'equal))
         (c (cl-find "C" placed :key (lambda (entry) (plist-get entry :text)) :test #'equal)))
    (should (= 3 (length placed)))
    (should-not (= (plist-get a :lane) (plist-get b :lane)))
    (should (= 2 (plist-get a :lanes)))
    (should (= 1 (plist-get c :lanes)))
    (should-not (plist-get (car entries) :row))))

(ert-deftest cfw-modern-extreme-overlap-stays-within-width-and-reports-overflow ()
  (let* ((entries (cl-loop for n below 30 collect (list :text (format "Meeting %d" n) :start 540 :end 600 :index n)))
         (column (cfw:modern--time-column entries cfw-modern-test-date 12 24 480 2)))
    (should (= 24 (length column)))
    (dolist (line column) (should (= 12 (string-width line))))
    (should (string-match-p "+28" (mapconcat #'identity column "\n")))))

(ert-deftest cfw-modern-native-and-org-time-ranges-are-visible ()
  (let* ((event (make-cfw:event :title "Meeting" :start-date cfw-modern-test-date :start-time '(9 30) :end-time '(10 45)))
         (native (cfw:modern--entry event cfw-modern-test-date))
         (org (cfw:modern--entry (propertize "09:30 TODO Task" 'time-of-day 930 'time "09:30-10:45") cfw-modern-test-date)))
    (should (string-prefix-p "09:30–10:45 " (cfw:modern--label native)))
    (should (equal "09:30–10:45 TODO Task" (cfw:modern--label org)))))

(ert-deftest cfw-modern-overnight-event-clips-to-each-day ()
  (let* ((begin '(10 16 2026)) (end '(10 17 2026))
         (event (make-cfw:event :title "Overnight" :start-date begin :end-date end :start-time '(23 0) :end-time '(1 0)))
         (first (cfw:modern--entry event begin begin end))
         (last (cfw:modern--entry event end begin end)))
    (should (= 1380 (plist-get first :start))) (should (= 1440 (plist-get first :end)))
    (should (= 0 (plist-get last :start))) (should (= 60 (plist-get last :end)))))

(ert-deftest cfw-modern-source-colours-are-consistent-and-distinct ()
  (let* ((red (make-cfw:source :name "Red" :color "red"))
         (blue (make-cfw:source :name "Blue" :color "blue"))
         (render (lambda (source)
                   (cfw:modern--entry-line (list :text "Task" :source source) "Task" 20 cfw-modern-test-date))))
    (should-not (equal (get-text-property 0 'face (funcall render red))
                       (get-text-property 0 'face (funcall render blue))))
    (should (equal (get-text-property 0 'face (funcall render red))
                   (get-text-property 0 'face (funcall render red))))))

(ert-deftest cfw-modern-narrow-window-has-no-horizontal-overflow ()
  (dolist (view '(month two-weeks week day))
    (let ((text (cfw-modern-test-render view 48 42 10)))
      (dolist (line (split-string text "\n")) (should (< (string-width line) 48))))))

(ert-deftest cfw-modern-classic-renderer-remains-available ()
  (let ((cfw:display-style 'classic))
    (should (eq #'cfw:view-two-weeks (cfw:cp-dispatch-view-impl 'two-weeks)))))

(ert-deftest cfw-modern-body-size-excludes-mode-and-header-lines ()
  (with-temp-buffer
    (let ((window (selected-window)))
      (set-window-buffer window (current-buffer))
      (setq-local header-line-format "Header")
      (let ((dest (cfw:dest-init-buffer (current-buffer))))
        (should (= (window-body-height window) (cfw:dest-height dest)))
        (should (= (window-body-width window) (cfw:dest-width dest)))))))

(defmacro cfw-modern-test-with-navigation (view width &rest body)
  (declare (indent 2))
  `(let* ((cfw:display-style 'modern) (cfw:display-calendar-holidays nil)
          (calendar-week-start-day 0)
          (dest (cfw:dest-init-inline ,width 62))
          (model (cfw:model-abstract-new '(11 3 2026) nil nil))
          (cp (cfw:cp-new dest model ,view '(11 3 2026))))
     (unwind-protect
         (with-current-buffer (cfw:cp-get-buffer cp)
           (setq-local cfw:component cp)
           (use-local-map cfw:calendar-mode-map)
           ,@body)
       (kill-buffer (cfw:cp-get-buffer cp)))))

(ert-deftest cfw-modern-fortnight-arrow-keys-follow-visible-cards ()
  (cfw-modern-test-with-navigation 'two-weeks 116
    (let ((line (line-number-at-pos)) (column (current-column)))
      (call-interactively (key-binding (kbd "<down>")))
      (should (equal '(11 4 2026) (cfw:component-selected cp)))
      (should (> (line-number-at-pos) line))
      (should (= column (current-column)))
      (call-interactively (key-binding (kbd "<up>")))
      (should (equal '(11 3 2026) (cfw:component-selected cp)))
      (should (= line (line-number-at-pos)))
      (call-interactively (key-binding (kbd "<right>")))
      (should (equal '(11 10 2026) (cfw:component-selected cp)))
      (should (= line (line-number-at-pos)))
      (should (> (current-column) column))
      (call-interactively (key-binding (kbd "<left>")))
      (should (equal '(11 3 2026) (cfw:component-selected cp)))
      (should (= column (current-column))))))

(ert-deftest cfw-modern-fortnight-vi-keys-and-prefix-counts ()
  (cfw-modern-test-with-navigation 'two-weeks 116
    (dolist (step '(("j" (11 4 2026)) ("l" (11 11 2026))
                    ("k" (11 10 2026)) ("h" (11 3 2026))))
      (call-interactively (key-binding (kbd (car step))))
      (should (equal (cadr step) (cfw:component-selected cp))))
    (cfw:navi-down-command 3)
    (should (equal '(11 6 2026) (cfw:component-selected cp)))
    (cfw:navi-up-command -2)
    (should (equal '(11 8 2026) (cfw:component-selected cp)))
    (cfw:navi-left-command 2)
    (should (equal '(10 25 2026) (cfw:component-selected cp)))))

(ert-deftest cfw-modern-fortnight-directions-cross-view-boundaries ()
  (cfw-modern-test-with-navigation 'two-weeks 116
    (dolist (step '(((11 1 2026) cfw:navi-up-command (10 31 2026))
                    ((11 7 2026) cfw:navi-down-command (11 8 2026))
                    ((11 10 2026) cfw:navi-right-command (11 17 2026))
                    ((11 3 2026) cfw:navi-left-command (10 27 2026))
                    ((12 31 2026) cfw:navi-down-command (1 1 2027))))
      (cfw:cp-set-selected-date cp (car step))
      (funcall (cadr step))
      (should (equal (nth 2 step) (cfw:component-selected cp)))
      (should (equal (nth 2 step) (cfw:cursor-to-date)))
      (should (cfw:cp-displayed-date-p cp (nth 2 step))))))

(ert-deftest cfw-modern-fortnight-narrow-column-only-moves-vertically ()
  (cfw-modern-test-with-navigation 'two-weeks 48
    (should (eq 'single-column cfw:navigation-layout))
    (cfw:navi-down-command)
    (should (equal '(11 4 2026) (cfw:component-selected cp)))
    (cfw:navi-right-command)
    (should (equal '(11 4 2026) (cfw:component-selected cp)))
    (cfw:navi-left-command)
    (should (equal '(11 4 2026) (cfw:component-selected cp)))
    (cfw:navi-up-command)
    (should (equal '(11 3 2026) (cfw:component-selected cp)))))

(ert-deftest cfw-modern-fortnight-navigation-does-not-leak-to-other-views ()
  (cfw-modern-test-with-navigation 'two-weeks 116
    (cfw:cp-set-view cp 'month)
    (cfw:navi-down-command)
    (should (equal '(11 10 2026) (cfw:component-selected cp)))
    (cfw:navi-right-command)
    (should (equal '(11 11 2026) (cfw:component-selected cp)))
    (cfw:cp-set-view cp 'two-weeks)
    (let ((cfw:display-style 'classic))
      (cfw:cp-update cp)
      (cfw:navi-up-command)
      (should (equal '(11 4 2026) (cfw:component-selected cp)))
      (cfw:navi-left-command)
      (should (equal '(11 3 2026) (cfw:component-selected cp))))))

(ert-deftest cfw-modern-fortnight-explicit-day-week-commands-keep-their-steps ()
  (cfw-modern-test-with-navigation 'two-weeks 116
    (cfw:navi-next-day-command)
    (should (equal '(11 4 2026) (cfw:component-selected cp)))
    (cfw:navi-previous-week-command)
    (should (equal '(10 28 2026) (cfw:component-selected cp)))))

