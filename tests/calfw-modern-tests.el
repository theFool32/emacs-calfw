      (goto-char (point-min))
      (let ((pos (text-property-not-all (point-min) (point-max) 'cfw:overflow-count nil)))
        (should pos)
        (should (= 9 (get-text-property pos 'cfw:overflow-count))))
      (should (search-forward "Task 02" nil t))
      (should-not (search-forward "Task 03" nil t)))))

(ert-deftest cfw-modern-timeline-summary-counts-hidden-items-once ()
