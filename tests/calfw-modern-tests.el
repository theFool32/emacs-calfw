(ert-deftest cfw-modern-full-day-range-fits-short-window-with-late-events ()
  (with-temp-buffer
    (let* ((date cfw-modern-test-date)
           (model `((contents . ((,date ,(make-cfw:event :title "Early" :start-date date :start-time '(0 0) :end-time '(0 15))
                                        ,(make-cfw:event :title "Late" :start-date date :start-time '(23 45) :end-time '(23 59)))))
                    (sorter . string-lessp))))
      (dolist (width '(80 116))
        (erase-buffer)
        (cfw:modern--timeline model (list date) width 14)
        (should (<= (count-lines (point-min) (point-max)) 14))
        (should (string-match-p "Early" (buffer-string)))
        (should (string-match-p "Late" (buffer-string)))
        (should-not (text-property-not-all (point-min) (point-max) 'cfw:overflow-count nil))))))

(ert-deftest cfw-modern-details-keep-every-item-and-the-overview-order ()
  (with-temp-buffer
    (let* ((date cfw-modern-test-date) (marker (point-marker))
           (org-done-keywords-for-agenda '("DONE"))
           (model `((contents . ((,date ,(make-cfw:event :title "Late meeting with full title" :start-date date :start-time '(16 0) :end-time '(17 0) :description "Full description")
                                        ,(propertize "DONE finished" 'todo-state "DONE")
                                        ,(propertize "Untimed Org task" 'org-marker marker)
                                        ,(make-cfw:event :title "Early meeting" :start-date date :start-time '(9 0) :end-time '(10 0)))))
                    (sorter . string-lessp)))
           (cfw:display-style 'modern)
           (text (cfw:details-layout date model)))
      (should (string-match-p "4 项" text))
      (should (< (string-match "Untimed Org task" text) (string-match "Early meeting" text)))
      (should (< (string-match "Early meeting" text) (string-match "Late meeting" text)))
      (should (< (string-match "Late meeting" text) (string-match "DONE finished" text)))
      (should (string-match-p "Full description" text))
      (should (eq marker (get-text-property (string-match "Untimed Org task" text) 'org-marker text)))
      (dolist (entry (cfw:modern--entries model date))
        (should (= (plist-get entry :index)
                   (get-text-property (string-match (regexp-quote (plist-get entry :text)) text) 'cfw:row-count text))))
      (cfw:details-mode)
      (should (derived-mode-p 'org-mode))
      (should-not truncate-lines)
      (should word-wrap))))

(ert-deftest cfw-modern-org-details-fold-without-editing-source-data ()
  (with-temp-buffer
    (let* ((date cfw-modern-test-date)
           (event (make-cfw:event :title "Meeting with full title" :start-date date
                                  :start-time '(9 0) :end-time '(10 0)
                                  :location "Room A" :description "Details\n* Literal note heading"))
           (model `((contents . ((,date ,event))) (sorter . string-lessp)))
           (text (cfw:modern-details-layout date model)))
      (cfw:details-mode)
      (let ((inhibit-read-only t)) (insert text))
      (goto-char (point-min))
      (should (= 2 (how-many "^\\*+ ")))
      (should (re-search-forward "^\\*\\* 09:00–10:00 Meeting with full title" nil t))
      (beginning-of-line)
      (should (eq #'org-cycle (key-binding (kbd "TAB"))))
      (org-cycle)
      (should (invisible-p (line-beginning-position 2)))
      (should buffer-read-only)
      (should-not buffer-file-name)
      (should-error (insert "Edit") :type 'buffer-read-only)
      (should (equal "Details\n* Literal note heading" (cfw:event-description event))))))

(ert-deftest cfw-modern-details-popup-starts-with-visible-headings-and-folded-bodies ()
  (let ((cfw:details-buffer-name " *cfw-details-test*"))
    (unwind-protect
        (progn
          (cl-letf (((symbol-function 'pop-to-buffer) (lambda (&rest _) nil)))
            (cfw:details-popup "* Day\n** First appointment\nFull body\n** Second appointment\nNotes\n"))
          (with-current-buffer cfw:details-buffer-name
            (should (derived-mode-p 'org-mode))
            (should buffer-read-only)
            (should-not (buffer-modified-p))
            (goto-char (point-min))
            (search-forward "First appointment")
            (should-not (invisible-p (line-beginning-position)))
            (should (invisible-p (line-beginning-position 2)))
            (search-forward "Second appointment")
            (should-not (invisible-p (line-beginning-position)))))
      (when-let* ((buffer (get-buffer cfw:details-buffer-name))) (kill-buffer buffer)))))

(ert-deftest cfw-modern-overlapping-events-get-distinct-lanes ()
  (let* ((entries (list (list :start 540 :end 600 :text "A")
                        (list :start 570 :end 660 :text "B")
                        (list :start 660 :end 720 :text "C")))
         (placed (cfw:modern--lanes entries 480 4))
         (a (cl-find "A" placed :key (lambda (entry) (plist-get entry :text)) :test #'equal))
         (b (cl-find "B" placed :key (lambda (entry) (plist-get entry :text)) :test #'equal))
         (c (cl-find "C" placed :key (lambda (entry) (plist-get entry :text)) :test #'equal)))
    (should (= 3 (length placed)))
    (should-not (= (plist-get a :lane) (plist-get b :lane)))
    (should (= 2 (plist-get a :lanes)))
    (should (= 1 (plist-get c :lanes)))
    (should-not (plist-get (car entries) :row))))

(ert-deftest cfw-modern-extreme-overlap-stays-within-width-and-reports-overflow ()
  (let* ((entries (cl-loop for n below 30 collect (list :text (format "Meeting %d" n) :start 540 :end 600 :index n)))
         (column (cfw:modern--time-column entries cfw-modern-test-date 12 24 480 2)))
    (should (= 24 (length column)))
    (dolist (line column) (should (= 12 (string-width line))))
    (should (string-match-p "+28" (mapconcat #'identity column "\n")))))

(ert-deftest cfw-modern-native-and-org-time-ranges-are-visible ()
  (let* ((event (make-cfw:event :title "Meeting" :start-date cfw-modern-test-date :start-time '(9 30) :end-time '(10 45)))
         (native (cfw:modern--entry event cfw-modern-test-date))
         (org (cfw:modern--entry (propertize "09:30 TODO Task" 'time-of-day 930 'time "09:30-10:45") cfw-modern-test-date)))
    (should (string-prefix-p "09:30–10:45 " (cfw:modern--label native)))
    (should (equal "09:30–10:45 TODO Task" (cfw:modern--label org)))))

(ert-deftest cfw-modern-overnight-event-clips-to-each-day ()
  (let* ((begin '(10 16 2026)) (end '(10 17 2026))
         (event (make-cfw:event :title "Overnight" :start-date begin :end-date end :start-time '(23 0) :end-time '(1 0)))
         (first (cfw:modern--entry event begin begin end))
         (last (cfw:modern--entry event end begin end)))
    (should (= 1380 (plist-get first :start))) (should (= 1440 (plist-get first :end)))
    (should (= 0 (plist-get last :start))) (should (= 60 (plist-get last :end)))))

(ert-deftest cfw-modern-source-colours-are-consistent-and-distinct ()
  (let* ((red (make-cfw:source :name "Red" :color "red"))
         (blue (make-cfw:source :name "Blue" :color "blue"))
         (render (lambda (source)
                   (cfw:modern--entry-line (list :text "Task" :source source) "Task" 20 cfw-modern-test-date))))
    (should-not (equal (get-text-property 0 'face (funcall render red))
                       (get-text-property 0 'face (funcall render blue))))
    (should (equal (get-text-property 0 'face (funcall render red))
                   (get-text-property 0 'face (funcall render red))))))

(ert-deftest cfw-modern-narrow-window-has-no-horizontal-overflow ()
