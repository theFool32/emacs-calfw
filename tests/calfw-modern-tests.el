;;; calfw-modern-tests.el --- Renderer regression tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'calfw-modern)
(defvar org-done-keywords-for-agenda)

(defconst cfw-modern-test-date '(10 16 2026))

(defun cfw-modern-test-source (&optional count)
  (make-cfw:source
   :name "caldav.feishu.cn / 测试日历" :color "#579fff"
   :data (lambda (_begin _end)
           (append
            (cl-loop for index below (or count 5)
                     collect (make-cfw:event :title (format "中文长标题会议 %d 与工作进度回顾" index)
                                             :start-date cfw-modern-test-date
                                             :start-time (list (+ 9 (% index 5)) 0)
                                             :end-time (list (+ 10 (% index 5)) 0)))
            (list (list cfw-modern-test-date
                        (propertize "TODO 中文工作任务" 'todo-state "TODO" 'org-marker (point-marker))))))))

(defun cfw-modern-test-render (view width height &optional count)
  (let ((cfw:display-style 'modern) (cfw:display-calendar-holidays nil))
    (cfw:get-calendar-text width height :date cfw-modern-test-date :view view
                           :contents-sources (list (cfw-modern-test-source count)))))

(ert-deftest cfw-modern-four-views-fit-normal-viewport ()
  (dolist (view '(day week two-weeks month))
    (dolist (size '((116 62) (90 42) (150 75)))
      (let ((text (cfw-modern-test-render view (car size) (cadr size) 20)))
        (should (<= (length (split-string text "\n")) (cadr size)))
        (dolist (line (split-string text "\n")) (should (< (string-width line) (car size))))))))

(ert-deftest cfw-modern-month-weekday-headings-follow-and-align-with-the-grid ()
  (dolist (calendar-week-start-day '(1 0))
    (dolist (width '(90 116 150))
      (let* ((text (cfw-modern-test-render 'month width 42))
             (lines (split-string text "\n"))
             (header (cl-find-if (lambda (line) (string-match-p "周一" line)) lines))
             (first-day (cl-find-if (lambda (line)
                                     (text-property-not-all 0 (length line) 'cfw:modern-header nil line))
                                   lines))
             (names ["周日" "周一" "周二" "周三" "周四" "周五" "周六"]))
        (should header)
        (should first-day)
        (let ((labels (split-string header "[ │]+" t))
              (days (cfw:view-model-make-day-names-for-week))
              (offset 0) (date-offset 0))
          (should (equal labels (mapcar (lambda (day) (aref names day)) days)))
          (dolist (day days)
            (let* ((name (aref names day))
                   (position (string-match (regexp-quote name) header offset))
                   (column (string-width (substring header 0 position)))
                   (date-position (string-match "[0-9]+" first-day date-offset))
                   (date-end (match-end 0))
                   (date (get-text-property date-position 'cfw:date first-day)))
              (should (= column (string-width (substring first-day 0 date-position))))
              (should (= day (calendar-day-of-week date)))
              (should (eq (get-text-property position 'face header)
                          (if (memq day '(0 6)) 'cfw:modern-weekend 'cfw:modern-day)))
              (setq offset (+ position (length name))
                    date-offset date-end))))))))

(ert-deftest cfw-modern-month-weekday-row-stays-within-the-height-budget ()
  (let ((cfw:display-style 'modern) (cfw:display-calendar-holidays nil)
        (calendar-week-start-day 1))
    ;; Months with four, five and six calendar rows.
    (dolist (date '((2 15 2027) (10 16 2026) (3 15 2026)))
      (dolist (size '((90 30) (116 42) (150 62)))
        (let* ((text (cfw:get-calendar-text (car size) (cadr size) :date date :view 'month))
               (lines (split-string text "\n")))
          (should (= 1 (cl-count-if (lambda (line) (string-match-p "周一" line)) lines)))
          (should (<= (length lines) (cadr size)))
          (dolist (line lines) (should (< (string-width line) (car size)))))))))

(ert-deftest cfw-modern-cards-distribute-all-remaining-lines ()
  (let ((model '((contents) (sorter . string-lessp)))
        (rows '(((10 11 2026) (10 18 2026))
                ((10 12 2026) (10 19 2026))
                ((10 13 2026) (10 20 2026)))))
    (dolist (height '(14 15 16 17 18))
      (with-temp-buffer
        (cfw:modern--cards model rows 100 height)
        (should (= height (count-lines (point-min) (point-max))))))))

(ert-deftest cfw-modern-timeline-keeps-partial-hour-height ()
  (let ((model '((contents) (sorter . string-lessp))))
    (dolist (height '(31 32 33 34 35 36 37 38 39))
      (with-temp-buffer
        (cfw:modern--timeline model (list cfw-modern-test-date) 100 height)
        ;; One line is reserved for overflow, even on an empty day.
        (should (= (1- height) (count-lines (point-min) (point-max))))))))

(ert-deftest cfw-modern-taller-glyphs-fit-pixels-without-querying-sources-twice ()
  (save-window-excursion
    (dolist (view '(month two-weeks week day))
      (let ((buffer (generate-new-buffer " *cfw-pixels-test*"))
            (cfw:display-style 'modern) (cfw:display-calendar-holidays nil) (calls 0))
        (unwind-protect
            (progn
              (switch-to-buffer buffer)
              (cl-letf (((symbol-function 'window-body-height)
                         (lambda (&optional _window pixels) (if pixels 560 35)))
                        ((symbol-function 'frame-char-height) (lambda (&optional _frame) 16))
                        ((symbol-function 'window-text-pixel-size)
                         (lambda (_window from to &rest _) (cons 400 (* 20 (count-lines from to))))))
                (cfw:create-calendar-component-buffer
                 :buffer buffer :date cfw-modern-test-date :view view
                 :contents-sources (list (make-cfw:source :name "CJK 日历"
                                                        :data (lambda (&rest _) (cl-incf calls) nil))))
                (should (<= (* 20 (count-lines (point-min) (point-max))) 560))
                (should (>= (* 20 (count-lines (point-min) (point-max))) 540))
                (should (= 1 calls))
                (should (= 20 cfw:modern--line-height))))
          (kill-buffer buffer))))))

(ert-deftest cfw-modern-details-open-and-close-refit-the-real-window-immediately ()
  (save-window-excursion
    (let ((buffer (generate-new-buffer " *cfw-window-test*"))
          (cfw:display-style 'modern) (cfw:display-calendar-holidays nil)
          (cfw:details-buffer-name " *cfw-details-window-test*"))
      (unwind-protect
          (progn
            (switch-to-buffer buffer)
            (cfw:create-calendar-component-buffer :buffer buffer :date cfw-modern-test-date :view 'day)
            (let ((height (window-body-height))
                  (display-buffer-alist '(("cfw-details-window-test" (display-buffer-at-bottom) (window-height . 5)))))
              (cfw:show-details-command)
              (let ((window (get-buffer-window buffer)))
                (should (< (window-body-height window) height))
                (should (equal (cons (window-body-width window) (window-body-height window))
                               (buffer-local-value 'cfw:modern--dimensions buffer))))
              (cfw:details-kill-buffer-command)
              (should (eq buffer (window-buffer)))
              (should (= height (window-body-height)))
              (should (equal (cons (window-body-width) height) cfw:modern--dimensions))
              (should-not (get-buffer cfw:details-buffer-name))))
        (when-let* ((details (get-buffer cfw:details-buffer-name))) (kill-buffer details))
        (kill-buffer buffer)))))

(ert-deftest cfw-modern-sources-stay-at-top-and-wrap ()
  (let* ((sources (cl-loop for index below 8
                          collect (make-cfw:source :name (format "账户 / 较长来源名称%d" index) :color "blue")))
         (legend (cfw:modern--legend sources 30)))
    (should (> (length legend) 1))
    (dolist (line legend) (should (<= (string-width line) 30)))
    (dolist (source sources)
      (should (cl-some (lambda (line) (text-property-any 0 (length line) 'cfw:source source line)) legend))))
  (let ((text (cfw-modern-test-render 'two-weeks 116 62)))
    (should (string-match "测试日历" (mapconcat #'identity (cl-subseq (split-string text "\n") 0 4) "\n")))))

(ert-deftest cfw-modern-dense-day-shows-exact-hidden-count ()
  (let* ((date cfw-modern-test-date)
         (model `((contents . ((,date ,@(cl-loop for n below 20 collect (format "Task %02d" n)))))
                  (sorter . string-lessp)))
         (card (cfw:modern--card model date 40 6))
         (shown (length (cl-remove-if-not (lambda (line) (get-text-property 0 'cfw:row-count line)) (cdr card)))))
    (should (= 6 (length card)))
    (should (string-match-p (regexp-quote (format "+%d 项" (- 20 shown))) (mapconcat #'identity card "\n")))
    (should (text-property-not-all 0 (length (nth shown (cdr card))) 'keymap nil (nth shown (cdr card))))))

(ert-deftest cfw-modern-keeps-org-marker-and-binds-overflow ()
  (with-temp-buffer
    (let* ((marker (point-marker))
           (item (propertize "TODO 任务" 'org-marker marker 'todo-state "TODO"))
           (entry (cfw:modern--entry item cfw-modern-test-date))
           (line (cfw:modern--entry-line entry (cfw:modern--label entry) 30 cfw-modern-test-date))
           (more (cfw:modern--more 10 30 cfw-modern-test-date)))
      (should (eq marker (get-text-property 0 'org-marker line)))
      (should (equal cfw-modern-test-date (get-text-property 0 'cfw:date line)))
      (should (eq #'cfw:modern--more-click (lookup-key (get-text-property 0 'keymap more) [mouse-1]))))))

(ert-deftest cfw-modern-month-keeps-long-events-on-one-line ()
  (let* ((date cfw-modern-test-date)
         (model `((contents . ((,date ,@(cl-loop for n below 8 collect
                                               (make-cfw:event :title (format "Meeting %d with a long title" n)
                                                               :start-date date :start-time (list (+ 9 n) 0)
                                                               :end-time (list (+ 10 n) 0))))))
                  (sorter . string-lessp)))
         (lines (cdr (cfw:modern--card model date 24 6 t))))
    (should (= 5 (length lines)))
    (should (= 4 (get-text-property 0 'cfw:overflow-count (car (last lines)))))
    (dolist (line (butlast lines))
      (should (string-match-p "[0-9][0-9]:00 Meeting" line))
      (should-not (string-match-p "–" line))
      (should (= 24 (string-width line))))))

(ert-deftest cfw-modern-crowded-wide-cards-use-one-line-per-item ()
  (let* ((entries (cl-loop for n below 4 collect
                           (list :text (format "Long task %d %s" n (make-string 80 ?x)) :index n)))
         (lines (cfw:modern--entry-lines entries cfw-modern-test-date 32 4)))
    (should (= 4 (length lines)))
    (should (= 0 (cfw:modern--hidden-count entries lines)))
    (should-not (cl-some (lambda (line) (get-text-property 0 'cfw:overflow-count line)) lines))))

(ert-deftest cfw-modern-exact-fit-and-small-capacity-have-no-silent-loss ()
  (let ((entries (cl-loop for n below 5 collect (list :text (format "Task %d" n) :index n))))
    (dolist (capacity '(1 2 4 5 6))
      (let* ((lines (cfw:modern--entry-lines entries cfw-modern-test-date 12 capacity t))
             (hidden (cfw:modern--hidden-count entries lines))
             (more (cl-find-if (lambda (line) (get-text-property 0 'cfw:overflow-count line)) lines)))
        (should (= capacity (length lines)))
        (if (= hidden 0) (should-not more)
          (should (= hidden (get-text-property 0 'cfw:overflow-count more)))
          (dolist (key '("RET" "SPC" "s"))
            (should (eq #'cfw:show-details-command (lookup-key (get-text-property 0 'keymap more) (kbd key))))))))))

(ert-deftest cfw-modern-overflow-is-reachable-in-every-view-and-narrow-fallback ()
  (dolist (width '(116 48))
    (dolist (view '(month two-weeks week day))
      (let* ((text (cfw-modern-test-render view width 42 200))
             (pos (text-property-not-all 0 (length text) 'cfw:overflow-count nil text)))
        (should pos)
        (should (equal cfw-modern-test-date (get-text-property pos 'cfw:date text)))
        (should (> (get-text-property pos 'cfw:overflow-count text) 0))
        (let ((face (get-text-property pos 'face text)))
          (should (or (eq 'cfw:modern-overflow face)
                      (memq 'cfw:modern-overflow face))))))))

(ert-deftest cfw-modern-overflow-key-opens-all-items-on-the-correct-day ()
  (dolist (view '(month two-weeks week day))
    (let* ((cfw:display-style 'modern) (cfw:display-calendar-holidays nil)
           (dest (cfw:dest-init-inline 116 42))
           (model (cfw:model-abstract-new cfw-modern-test-date (list (cfw-modern-test-source 200)) nil))
           (cp (cfw:cp-new dest model view cfw-modern-test-date)) detail)
      (unwind-protect
          (with-current-buffer (cfw:cp-get-buffer cp)
            (setq-local cfw:component cp)
            (goto-char (text-property-not-all (point-min) (point-max) 'cfw:overflow-count nil))
            (cl-letf (((symbol-function 'cfw:details-popup) (lambda (text) (setq detail text))))
              (call-interactively (lookup-key (get-text-property (point) 'keymap) (kbd "RET"))))
            (should (string-match-p "2026/10/16" detail))
            (should (string-match-p "201 项" detail))
            (should (string-match-p "中文长标题会议 199 与工作进度回顾" detail))
            (should (string-match-p "TODO 中文工作任务" detail)))
        (kill-buffer (cfw:cp-get-buffer cp))))))

(ert-deftest cfw-modern-all-day-overflow-uses-an-exact-count ()
